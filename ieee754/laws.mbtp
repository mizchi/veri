///|
pub lemma neg_preserves_nan(x : Float64) where {
  proof_ensure: is_nan(neg(x)) == is_nan(x),
} {}

///|
pub lemma abs_preserves_nan(x : Float64) where {
  proof_ensure: is_nan(abs(x)) == is_nan(x),
} {}

///|
pub lemma nan_is_not_equal(x : Float64) where {
  proof_require: is_nan(x),
  proof_ensure: eq(x, x) == false,
} {}

///|
pub lemma non_nan_is_equal(x : Float64) where {
  proof_require: is_nan(x) == false,
  proof_ensure: eq(x, x),
} {}

///|
pub lemma signed_zeros_compare_equal() where {
  proof_ensure: eq(zero(), neg(zero())),
} {}

///|
pub lemma zero_divided_by_zero_is_nan(mode : RoundingMode) where {
  proof_ensure: is_nan(div(mode, zero(), zero())),
} {}

///|
pub lemma finite_self_subtraction_is_zero(x : Float64, mode : RoundingMode) where {
  proof_require: is_finite(x),
  proof_ensure: is_zero(sub(mode, x, x)),
} {}
