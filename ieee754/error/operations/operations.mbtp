///|
pub lemma sub64(x : @ieee754.Float64, y : @ieee754.Float64) where {
  proof_require: @ieee754.is_finite(x),
  proof_require: @ieee754.is_finite(y),
  proof_require: @error.no_overflow64(@ieee754.nearest_even(), @real.sub(@error.to_real64(x), @error.to_real64(y))),
