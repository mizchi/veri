test "div/nan/one" {
  let a = 0x7ff8000000000001UL.reinterpret_as_double()
  let b = 0x3ff0000000000000UL.reinterpret_as_double()
  let actual = @float64.div(a, b)
  let native = a / b
  assert_true(@float64.matches(actual, AnyNaN))
  assert_true(@float64.matches(native, AnyNaN))
  assert_eq(@float64.is_nan(a), true)
  assert_eq(@float64.is_infinite(a), false)
  assert_eq(@float64.eq(a, b), false)
  assert_eq(@float64.less(a, b), false)
}

///|
test "sqrt/zero" {
  let a = 0x0000000000000000UL.reinterpret_as_double()
  let actual = @float64.sqrt(a)
  let native = a.sqrt()
  assert_eq(actual.reinterpret_as_uint64(), 0x0000000000000000UL)
  assert_eq(native.reinterpret_as_uint64(), 0x0000000000000000UL)
  assert_eq(@float64.is_nan(a), false)
  assert_eq(@float64.is_infinite(a), false)
  assert_eq(@float64.eq(a, a), true)
  assert_eq(@float64.less(a, a), false)
  let roundtrip = @float64.from_bits(0x0000000000000000UL)
  assert_eq(@float64.to_bits(roundtrip), 0x0000000000000000UL)
}

