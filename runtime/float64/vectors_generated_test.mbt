// Generated by tools/generate-floats.mjs using Z3's IEEE FP theory.
// RNE; exact non-NaN encodings; NaN payload and flags are not checked.

///|
test "add/one/halfUlp" {
  let a = 0x3ff0000000000000UL.reinterpret_as_double()
  let b = 0x3ca0000000000000UL.reinterpret_as_double()
  let actual = @float64.add(a, b)
  let native = a + b
  assert_eq(actual.reinterpret_as_uint64(), 0x3ff0000000000000UL)
  assert_eq(native.reinterpret_as_uint64(), 0x3ff0000000000000UL)
  assert_eq(@float64.is_nan(a), false)
  assert_eq(@float64.is_infinite(a), false)
  assert_eq(@float64.eq(a, b), false)
  assert_eq(@float64.less(a, b), false)
  let roundtrip = @float64.from_bits(0x3ff0000000000000UL)
  assert_eq(@float64.to_bits(roundtrip), 0x3ff0000000000000UL)
}

