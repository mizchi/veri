///|
test "add/inf/negInf" {
  let a = 0x7ff0000000000000UL.reinterpret_as_double()
  let b = 0xfff0000000000000UL.reinterpret_as_double()
  let actual = a + b
  assert_true(@float64.matches(actual, AnyNaN))
}

