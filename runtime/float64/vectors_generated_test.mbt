// Generated by tools/generate-float64.mjs using Z3's IEEE FP theory.
// RNE; exact non-NaN encodings; NaN payload and flags are not checked.

///|
test "add/one/halfUlp" {
  let a = 0x3ff0000000000000UL.reinterpret_as_double()
  let b = 0x3ca0000000000000UL.reinterpret_as_double()
  let actual = a + b
  assert_eq(actual.reinterpret_as_uint64(), 0x3ff0000000000000UL)
}

///|
test "add/nextOne/halfUlp" {
  let a = 0x3ff0000000000001UL.reinterpret_as_double()
  let b = 0x3ca0000000000000UL.reinterpret_as_double()
  let actual = a + b
  assert_eq(actual.reinterpret_as_uint64(), 0x3ff0000000000002UL)
}

///|
test "add/minSub/minSub" {
  let a = 0x0000000000000001UL.reinterpret_as_double()
  let b = 0x0000000000000001UL.reinterpret_as_double()
  let actual = a + b
  assert_eq(actual.reinterpret_as_uint64(), 0x0000000000000002UL)
}

///|
test "add/maxSub/minSub" {
  let a = 0x000fffffffffffffUL.reinterpret_as_double()
  let b = 0x0000000000000001UL.reinterpret_as_double()
  let actual = a + b
  assert_eq(actual.reinterpret_as_uint64(), 0x0010000000000000UL)
}

///|
