///|
fn contents(heap : Heap) -> @bag.Bag[Int] {
  match heap {
    Empty => @bag.empty()
    Node(left, value, right) => @bag.add(value, @bag.union(contents(left), contents(right)))
  }
}

///|
predicate all_ge(value : Int, heap : Heap) {
  ∀ other : Int, @bag.mem(other, contents(heap)) → value <= other
}

///|
predicate ordered(heap : Heap) {
  match heap {
    Empty => true
    Node(left, value, right) => ordered(left) && ordered(right) && all_ge(value, left)
  }
}

///|
pub fn model(queue : IntMinQueue) -> @bag.Bag[Int] {
  contents(queue.values)
}

///|
pub predicate valid(queue : IntMinQueue) {
  ordered(queue.values) && root(queue.values)
}

///|
pub predicate minimum(value : Int, queue : IntMinQueue) {
  @bag.mem(value, model(queue)) &&
  (∀ other : Int, @bag.mem(other, model(queue)) → value <= other)
}

///|
fn heap_size(heap : Heap) -> @integer.Integer {
  @bag.size(contents(heap))
}

///|
predicate root(heap : Heap) {
  match heap {
    Empty => true
    Node(_children, _value, Empty) => true
    Node(_children, _value, Node(_a, _x, _b)) => false
  }
}
