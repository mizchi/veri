///|
fn contents(heap : Heap) -> @bag.Bag[Int] {
  match heap {
    Empty => @bag.empty()
    Node(left, value, right) => @bag.add(value, @bag.union(contents(left), contents(right)))
  }
}

///|
predicate all_ge(value : Int, heap : Heap) {
  ∀ other : Int, @bag.mem(other, contents(heap)) → value <= other
}

///|
predicate ordered(heap : Heap) {
  match heap {
    Empty => true
    Node(left, value, right) => ordered(left) && ordered(right) && all_ge(value, left) && all_ge(value, right)
  }
}

///|
pub fn model(queue : PriorityQueue) -> @bag.Bag[Int] {
  contents(queue.values)
}

///|
pub predicate valid(queue : PriorityQueue) {
  ordered(queue.values)
}

///|
pub predicate minimum(value : Int, queue : PriorityQueue) {
  @bag.mem(value, model(queue)) &&
  (∀ other : Int, @bag.mem(other, model(queue)) → value <= other)
}

///|
fn total_size(left : Heap, right : Heap) -> @integer.Integer {
  @integer.add(@bag.size(contents(left)), @bag.size(contents(right)))
}
