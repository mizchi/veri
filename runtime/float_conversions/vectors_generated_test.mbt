// Generated by tools/generate-floats.mjs using Z3's IEEE FP theory.
// RNE; exact non-NaN encodings; NaN payload and flags are not checked.

///|
test "binary64 to binary32 case 0" {
  let input = 0x0000000000000000UL.reinterpret_as_double()
  let actual = @float64.to_float(input)
  let native = Float::from_double(input)
  assert_eq(actual.reinterpret_as_uint(), 0x00000000U)
  assert_eq(native.reinterpret_as_uint(), 0x00000000U)
}

