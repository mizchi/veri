///|
test "abs/four" {
  let a = Float::reinterpret_from_uint(0x40800000U)
  let actual = @float32.abs(a)
  let native = a.abs()
  assert_eq(actual.reinterpret_as_uint(), 0x40800000U)
  assert_eq(native.reinterpret_as_uint(), 0x40800000U)
  assert_eq(@float32.is_nan(a), false)
  assert_eq(@float32.is_infinite(a), false)
  assert_eq(@float32.eq(a, a), true)
  assert_eq(@float32.less(a, a), false)
  let roundtrip = @float32.from_bits(0x40800000U)
  assert_eq(@float32.to_bits(roundtrip), 0x40800000U)
}

