///|
test "sqrt/sample-0" {
  let a = Float::reinterpret_from_uint(0x0b572402U)
  let actual = @float32.sqrt(a)
  let native = a.sqrt()
  assert_eq(actual.reinterpret_as_uint(), 0x256aaecbU)
  assert_eq(native.reinterpret_as_uint(), 0x256aaecbU)
  assert_eq(@float32.is_nan(a), false)
  assert_eq(@float32.is_infinite(a), false)
  assert_eq(@float32.eq(a, a), true)
  assert_eq(@float32.less(a, a), false)
  let roundtrip = @float32.from_bits(0x0b572402U)
  assert_eq(@float32.to_bits(roundtrip), 0x0b572402U)
}

///|
test "sqrt/sample-1" {
  let a = Float::reinterpret_from_uint(0xc19ccacaU)
  let actual = @float32.sqrt(a)
  let native = a.sqrt()
  assert_true(@float32.matches(actual, AnyNaN))
  assert_true(@float32.matches(native, AnyNaN))
  assert_eq(@float32.is_nan(a), false)
  assert_eq(@float32.is_infinite(a), false)
  assert_eq(@float32.eq(a, a), true)
  assert_eq(@float32.less(a, a), false)
  let roundtrip = @float32.from_bits(0xc19ccacaU)
  assert_eq(@float32.to_bits(roundtrip), 0xc19ccacaU)
}

