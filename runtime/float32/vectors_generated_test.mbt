// Generated by tools/generate-floats.mjs using Z3's IEEE FP theory.
// RNE; exact non-NaN encodings; NaN payload and flags are not checked.

///|
test "add/one/halfUlp" {
  let a = Float::reinterpret_from_uint(0x3f800000U)
  let b = Float::reinterpret_from_uint(0x33800000U)
  let actual = @float32.add(a, b)
  let native = a + b
  assert_eq(actual.reinterpret_as_uint(), 0x3f800000U)
  assert_eq(native.reinterpret_as_uint(), 0x3f800000U)
  assert_eq(@float32.is_nan(a), false)
  assert_eq(@float32.is_infinite(a), false)
  assert_eq(@float32.eq(a, b), false)
  assert_eq(@float32.less(a, b), false)
  let roundtrip = @float32.from_bits(0x3f800000U)
  assert_eq(@float32.to_bits(roundtrip), 0x3f800000U)
}

