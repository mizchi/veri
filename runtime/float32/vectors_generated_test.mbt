///|
test "mul/sample-5" {
  let a = Float::reinterpret_from_uint(0x27693f93U)
  let b = Float::reinterpret_from_uint(0xdac2692cU)
  let actual = @float32.mul(a, b)
  let native = a * b
  assert_eq(actual.reinterpret_as_uint(), 0xc2b12201U)
  assert_eq(native.reinterpret_as_uint(), 0xc2b12201U)
  assert_eq(@float32.is_nan(a), false)
  assert_eq(@float32.is_infinite(a), false)
  assert_eq(@float32.eq(a, b), false)
  assert_eq(@float32.less(a, b), false)
  let roundtrip = @float32.from_bits(0x27693f93U)
  assert_eq(@float32.to_bits(roundtrip), 0x27693f93U)
}

