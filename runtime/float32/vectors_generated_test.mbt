test "div/sample-0" {
  let a = Float::reinterpret_from_uint(0x6c71e388U)
  let b = Float::reinterpret_from_uint(0x683ee24fU)
  let actual = @float32.div(a, b)
  let native = a / b
  assert_eq(actual.reinterpret_as_uint(), 0x43a233b5U)
  assert_eq(native.reinterpret_as_uint(), 0x43a233b5U)
  assert_eq(@float32.is_nan(a), false)
  assert_eq(@float32.is_infinite(a), false)
  assert_eq(@float32.eq(a, b), false)
  assert_eq(@float32.less(a, b), false)
  let roundtrip = @float32.from_bits(0x6c71e388U)
  assert_eq(@float32.to_bits(roundtrip), 0x6c71e388U)
}

