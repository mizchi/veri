test "div/nan/one" {
  let a = Float::reinterpret_from_uint(0x7fc00001U)
  let b = Float::reinterpret_from_uint(0x3f800000U)
  let actual = @float32.div(a, b)
  let native = a / b
  assert_true(@float32.matches(actual, AnyNaN))
  assert_true(@float32.matches(native, AnyNaN))
  assert_eq(@float32.is_nan(a), true)
  assert_eq(@float32.is_infinite(a), false)
  assert_eq(@float32.eq(a, b), false)
  assert_eq(@float32.less(a, b), false)
}

///|
test "sqrt/zero" {
  let a = Float::reinterpret_from_uint(0x00000000U)
  let actual = @float32.sqrt(a)
  let native = a.sqrt()
  assert_eq(actual.reinterpret_as_uint(), 0x00000000U)
  assert_eq(native.reinterpret_as_uint(), 0x00000000U)
  assert_eq(@float32.is_nan(a), false)
  assert_eq(@float32.is_infinite(a), false)
  assert_eq(@float32.eq(a, a), true)
  assert_eq(@float32.less(a, a), false)
  let roundtrip = @float32.from_bits(0x00000000U)
  assert_eq(@float32.to_bits(roundtrip), 0x00000000U)
}

