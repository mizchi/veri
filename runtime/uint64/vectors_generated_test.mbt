  assert_eq((sa + sb).reinterpret_as_uint64(), 0x06f1a62ee14d084fUL)
  assert_eq((sa - sb).reinterpret_as_uint64(), 0x3686a796427a88b1UL)
  assert_eq((sa * sb).reinterpret_as_uint64(), 0xd83f5a67c2069f80UL)
}

