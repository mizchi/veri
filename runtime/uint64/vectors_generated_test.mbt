  assert_eq((sa + sb).reinterpret_as_uint64(), 0x7cfaba0f187474b3UL)
  assert_eq((sa - sb).reinterpret_as_uint64(), 0xa8d8da7e19855f89UL)
  assert_eq((sa * sb).reinterpret_as_uint64(), 0x47dc48b5175a6f76UL)
}

