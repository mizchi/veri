// Generated by tools/generate-runtime.mjs using Z3; do not edit.
// Shift counts are in [0, width); native overshifts are not SMT overshifts.

///|
test "Z3 bitpattern 64 case 0" {
  let a = 0x0000000000000000UL
  let b = 0x0000000000000000UL
  let sa = a.reinterpret_as_int64()
  let sb = b.reinterpret_as_int64()
  assert_eq(@uint64.add(a, b), 0x0000000000000000UL)
  assert_eq(a + b, 0x0000000000000000UL)
  assert_eq(@uint64.sub(a, b), 0x0000000000000000UL)
  assert_eq(a - b, 0x0000000000000000UL)
  assert_eq(a * b, 0x0000000000000000UL)
  assert_eq(a & b, 0x0000000000000000UL)
  assert_eq(a | b, 0x0000000000000000UL)
  assert_eq(a ^ b, 0x0000000000000000UL)
  assert_eq(a.lnot(), 0xffffffffffffffffUL)
  assert_eq(a < b, false)
  assert_eq(@uint64.less(a, b), false)
  assert_eq(sa < sb, false)
  assert_eq(a << 0, 0x0000000000000000UL)
  assert_eq(a >> 0, 0x0000000000000000UL)
  assert_eq((sa >> 0).reinterpret_as_uint64(), 0x0000000000000000UL)
  assert_eq((sa + sb).reinterpret_as_uint64(), 0x0000000000000000UL)
  assert_eq((sa - sb).reinterpret_as_uint64(), 0x0000000000000000UL)
  assert_eq((sa * sb).reinterpret_as_uint64(), 0x0000000000000000UL)
}

