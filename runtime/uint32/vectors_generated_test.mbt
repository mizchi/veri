  assert_eq(a * b, 0x5b130162U)
  assert_eq(a & b, 0x1b006190U)
  assert_eq(a | b, 0xff4f6bbbU)
  assert_eq(a ^ b, 0xe44f0a2bU)
  assert_eq(a.lnot(), 0x44f5964dU)
  assert_eq(a < b, false)
  assert_eq(@uint32.less(a, b), false)
  assert_eq(sa < sb, true)
  assert_eq(a << 1, 0x7614d364U)
  assert_eq(a >> 1, 0x5d8534d9U)
  assert_eq((sa >> 1).reinterpret_as_uint(), 0xdd8534d9U)
  assert_eq((sa + sb).reinterpret_as_uint(), 0x1a4fcd4bU)
  assert_eq((sa - sb).reinterpret_as_uint(), 0x5bc50619U)
  assert_eq((sa * sb).reinterpret_as_uint(), 0x5b130162U)
}

