// Generated by tools/generate-runtime.mjs using Z3; do not edit.
// Shift counts are in [0, width); native overshifts are not SMT overshifts.

///|
test "Z3 bitpattern 32 case 0" {
  let a = 0x00000000U
  let b = 0x00000000U
  let sa = a.reinterpret_as_int()
  let sb = b.reinterpret_as_int()
  assert_eq(@uint32.add(a, b), 0x00000000U)
  assert_eq(a + b, 0x00000000U)
  assert_eq(@uint32.sub(a, b), 0x00000000U)
  assert_eq(a - b, 0x00000000U)
  assert_eq(a * b, 0x00000000U)
  assert_eq(a & b, 0x00000000U)
  assert_eq(a | b, 0x00000000U)
  assert_eq(a ^ b, 0x00000000U)
  assert_eq(a.lnot(), 0xffffffffU)
  assert_eq(a < b, false)
  assert_eq(@uint32.less(a, b), false)
  assert_eq(sa < sb, false)
  assert_eq(a << 0, 0x00000000U)
  assert_eq(a >> 0, 0x00000000U)
  assert_eq((sa >> 0).reinterpret_as_uint(), 0x00000000U)
  assert_eq((sa + sb).reinterpret_as_uint(), 0x00000000U)
  assert_eq((sa - sb).reinterpret_as_uint(), 0x00000000U)
  assert_eq((sa * sb).reinterpret_as_uint(), 0x00000000U)
}

