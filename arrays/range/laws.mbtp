///|
pub lemma[T] store_preserves_outside(before : @arrays.SmtArray[@integer.Integer, T], length : @integer.Integer, index : @integer.Integer, value : T) where {
  proof_require: valid(length, index, @integer.one()),
  proof_ensure: filled(before, @arrays.store(before, index, value), length, index, @integer.one(), value),
} {}

///|
pub lemma[T] swap_exchanges(before : @arrays.SmtArray[@integer.Integer, T], length : @integer.Integer, left : @integer.Integer, right : @integer.Integer) where {
  proof_require: valid(length, left, @integer.one()),
  proof_require: valid(length, right, @integer.one()),
  proof_ensure: exchange(before, swap(before, left, right), @integer.zero(), length, left, right),
} {}

///|
pub lemma[T] swap_twice(before : @arrays.SmtArray[@integer.Integer, T], left : @integer.Integer, right : @integer.Integer) where {
  proof_ensure: @arrays.eq(swap(swap(before, left, right), left, right), before),
} {}

///|
pub lemma[T] empty_fill(before : @arrays.SmtArray[@integer.Integer, T], length : @integer.Integer, start : @integer.Integer, value : T) where {
  proof_require: valid(length, start, @integer.zero()),
  proof_ensure: filled(before, before, length, start, @integer.zero(), value),
} {}

///|
/// Extending a completed prefix by one cell preserves the full frame.
pub lemma[T] fill_extend(before : @arrays.SmtArray[@integer.Integer, T], intermediate : @arrays.SmtArray[@integer.Integer, T], length : @integer.Integer, start : @integer.Integer, count : @integer.Integer, value : T) where {
  proof_require: filled(before, intermediate, length, start, count, value),
  proof_require: valid(length, start, @integer.add(count, @integer.one())),
  proof_ensure: filled(before, @arrays.store(intermediate, @integer.add(start, count), value), length, start, @integer.add(count, @integer.one()), value),
} {}

///|
pub lemma[T] copy_empty(source : @arrays.SmtArray[@integer.Integer, T], target : @arrays.SmtArray[@integer.Integer, T], source_length : @integer.Integer, target_length : @integer.Integer, source_start : @integer.Integer, target_start : @integer.Integer) where {
  proof_require: valid(source_length, source_start, @integer.zero()),
  proof_require: valid(target_length, target_start, @integer.zero()),
  proof_ensure: copied(source, target, target, source_length, target_length, source_start, target_start, @integer.zero()),
} {}

///|
/// Copy from an immutable pre-state model, even if source and target overlap.
pub lemma[T] copy_extend(source : @arrays.SmtArray[@integer.Integer, T], target_before : @arrays.SmtArray[@integer.Integer, T], intermediate : @arrays.SmtArray[@integer.Integer, T], source_length : @integer.Integer, target_length : @integer.Integer, source_start : @integer.Integer, target_start : @integer.Integer, count : @integer.Integer) where {
  proof_require: copied(source, target_before, intermediate, source_length, target_length, source_start, target_start, count),
  proof_require: valid(source_length, source_start, @integer.add(count, @integer.one())),
  proof_require: valid(target_length, target_start, @integer.add(count, @integer.one())),
  proof_ensure: copied(source, target_before, @arrays.store(intermediate, @integer.add(target_start, count), @arrays.select(source, @integer.add(source_start, count))), source_length, target_length, source_start, target_start, @integer.add(count, @integer.one())),
} {}
