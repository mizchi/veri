(set-logic QF_LRA)
(define-fun abs ((x Real)) Real (ite (< x 0.0) (- x) x))
(declare-const x Real)
(declare-const y Real)
(declare-const ideal_x Real)
(declare-const ideal_y Real)
(declare-const ex Real)
(declare-const ey Real)
(assert (<= (abs (- x ideal_x)) ex))
(assert (<= (abs (- y ideal_y)) ey))
(assert (not (<= (abs (- (+ x y) (+ ideal_x ideal_y))) (+ ex ey))))
(check-sat)
