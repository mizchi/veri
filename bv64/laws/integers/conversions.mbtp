///|
pub lemma integer_roundtrip(value : @integer.Integer) where {
  proof_ensure: @integer.eq(
    @bv64.to_integer(@bv64.of_integer(value)),
    @integer.modulo(value, @bv64.modulus()),
  ),
} {}

///|
pub lemma bitvector_roundtrip(value : @bv64.Bv64) where {
  proof_ensure: @bv64.eq(@bv64.of_integer(@bv64.to_integer(value)), value),
} {
  proof_assert @bv64.in_range(@bv64.to_integer(value))
  proof_assert @integer.eq(
    @bv64.to_integer(@bv64.of_integer(@bv64.to_integer(value))),
    @bv64.to_integer(value),
  )
}

///|
pub lemma unsigned_value_in_range(value : @bv64.Bv64) where {
  proof_ensure: @bv64.in_range(@bv64.to_integer(value)),
} {}
