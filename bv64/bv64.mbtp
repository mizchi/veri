///|
#proof_import("bv.BV64")
pub fn zero() -> Bv64 = "zeros"

///|
#proof_import("bv.BV64")
pub fn one() -> Bv64 = "one"

///|
#proof_import("bv.BV64")
pub fn ones() -> Bv64 = "ones"

///|
#proof_import("bv.BV64")
pub fn width() -> Bv64 = "size_bv"

///|
#proof_import("bv.BV64")
pub fn bw_not(x : Bv64) -> Bv64 = "bw_not"

///|
#proof_import("bv.BV64")
pub fn neg(x : Bv64) -> Bv64 = "neg"

///|
#proof_import("bv.BV64")
pub fn add(x : Bv64, y : Bv64) -> Bv64 = "add"

///|
#proof_import("bv.BV64")
pub fn sub(x : Bv64, y : Bv64) -> Bv64 = "sub"

///|
#proof_import("bv.BV64")
pub fn mul(x : Bv64, y : Bv64) -> Bv64 = "mul"

///|
#proof_import("bv.BV64")
pub fn udiv(x : Bv64, y : Bv64) -> Bv64 = "udiv"

///|
#proof_import("bv.BV64")
pub fn urem(x : Bv64, y : Bv64) -> Bv64 = "urem"

///|
#proof_import("bv.BV64")
pub fn sdiv(x : Bv64, y : Bv64) -> Bv64 = "sdiv"

///|
#proof_import("bv.BV64")
pub fn srem(x : Bv64, y : Bv64) -> Bv64 = "srem"

///|
#proof_import("bv.BV64")
pub fn bw_and(x : Bv64, y : Bv64) -> Bv64 = "bw_and"

///|
#proof_import("bv.BV64")
pub fn bw_or(x : Bv64, y : Bv64) -> Bv64 = "bw_or"

///|
#proof_import("bv.BV64")
pub fn bw_xor(x : Bv64, y : Bv64) -> Bv64 = "bw_xor"

///|
#proof_import("bv.BV64")
pub fn eq(x : Bv64, y : Bv64) -> Bool = "(=)"

///|
#proof_import("bv.BV64")
pub fn ult(x : Bv64, y : Bv64) -> Bool = "ult"

///|
#proof_import("bv.BV64")
pub fn ule(x : Bv64, y : Bv64) -> Bool = "ule"

///|
#proof_import("bv.BV64")
pub fn slt(x : Bv64, y : Bv64) -> Bool = "slt"

///|
#proof_import("bv.BV64")
pub fn sle(x : Bv64, y : Bv64) -> Bool = "sle"

///|
#proof_import("bv.BV64")
pub fn shl(x : Bv64, count : Bv64) -> Bv64 = "lsl_bv"

