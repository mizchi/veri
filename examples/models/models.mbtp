///| A downstream proof can use the finite-set model.
lemma singleton_contains(value : Int) where {
  proof_ensure: @fset.mem(value, @fset.add(value, @fset.empty())),
} {}

///| A downstream proof can use IEEE operations without assuming real arithmetic.
lemma adding_nan_is_nan(x : @ieee754.Float64, y : @ieee754.Float64) where {
  proof_require: @ieee754.is_nan(x),
  proof_ensure: @ieee754.is_nan(@ieee754.add(@ieee754.nearest_even(), x, y)),
} {}

///| Clear the lowest set bit using modular arithmetic, including x = 0.
lemma clear_lowest_bit_never_increases(x : @bv32.Bv32) where {
  proof_ensure: @bv32.ule(@bv32.bw_and(x, @bv32.sub(x, @bv32.one())), x),
} {}

///| The array's key and value sorts can themselves be other theory types.
lemma read_written_text(
  array : @arrays.SmtArray[@bv64.Bv64, @strings.Text],
  key : @bv64.Bv64,
  text : @strings.Text,
) where {
  proof_ensure: @strings.eq(@arrays.select(@arrays.store(array, key, text), key), text),
} {}
