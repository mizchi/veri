///|
/// The unsigned numerical value of a bit pattern.
#proof_import("bv.BV8")
pub fn Bv8::to_integer(value : Bv8) -> @integer.Integer = "t'int"

///|
#proof_import("bv.BV8")
pub fn Bv8::modulus() -> @integer.Integer = "two_power_size"

///|
#proof_import("bv.BV8")
pub fn Bv8::in_range(value : @integer.Integer) -> Bool = "uint_in_range"

///|
#proof_import("bv.BV8")
fn Bv8::raw_of_integer(value : @integer.Integer) -> Bv8 = "of_int"

///|
/// Total modular conversion, including negative and oversized integers.
/// Why3's raw of_int only guarantees the unsigned value for in-range inputs.
pub fn Bv8::of_integer(value : @integer.Integer) -> Bv8 {
  Bv8::raw_of_integer(@integer.modulo(value, Bv8::modulus()))
}
