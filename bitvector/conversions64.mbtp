///|
/// The unsigned numerical value of a bit pattern.
#proof_import("bv.BV64")
pub fn Bv64::to_integer(value : Bv64) -> @integer.Integer = "t'int"

///|
#proof_import("bv.BV64")
pub fn Bv64::modulus() -> @integer.Integer = "two_power_size"

///|
#proof_import("bv.BV64")
pub fn Bv64::in_range(value : @integer.Integer) -> Bool = "uint_in_range"

///|
#proof_import("bv.BV64")
fn Bv64::raw_of_integer(value : @integer.Integer) -> Bv64 = "of_int"

///|
/// Total modular conversion, including negative and oversized integers.
/// Why3's raw of_int only guarantees the unsigned value for in-range inputs.
pub fn Bv64::of_integer(value : @integer.Integer) -> Bv64 {
  Bv64::raw_of_integer(@integer.modulo(value, Bv64::modulus()))
}
