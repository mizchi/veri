pub fn Bv32::to_bv16(x : Bv32) -> Bv16 { Bv16::of_integer(Bv32::to_integer(x)) }

///|
/// Unsigned width conversion. Narrowing keeps the least significant bits.
pub fn Bv32::to_bv64(x : Bv32) -> Bv64 { Bv64::of_integer(Bv32::to_integer(x)) }

///|
