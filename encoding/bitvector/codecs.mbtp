///|
/// Connect the positional codec to the unsigned bitvector interpretation.
pub lemma bitvector_codec8(value : Bv8) where {
 proof_ensure: Bv8::eq(Bv8::of_integer(@encoding.decode_le(@encoding.encode_le8(Bv8::to_integer(value)))), value),
 proof_ensure: Bv8::eq(Bv8::of_integer(@encoding.decode_be(@encoding.encode_be8(Bv8::to_integer(value)))), value),
} {
 proof_assert Bv8::in_range(Bv8::to_integer(value))
 proof_assert @integer.eq(Bv8::to_integer(Bv8::of_integer(Bv8::to_integer(value))), Bv8::to_integer(value))
 proof_assert Bv8::eq(Bv8::of_integer(Bv8::to_integer(value)), value)
 proof_assert @integer.eq(@encoding.decode_le(@encoding.encode_le8(Bv8::to_integer(value))), Bv8::to_integer(value))
 proof_assert @integer.eq(@encoding.decode_be(@encoding.encode_be8(Bv8::to_integer(value))), Bv8::to_integer(value))
}
